# Configuración de la Base de Datos MySQL
DB_HOST=localhost
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=agroassist

# Configuración del Servidor
PORT=3000

# Configuración de JWT
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui

# Configuración de Email (SendGrid)
SENDGRID_API_KEY=tu_sendgrid_api_key

# Configuración de Email (Nodemailer - alternativo)
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_password_de_aplicacion

# Configuración de API del Clima
# Obtén tu API key gratuita en: https://openweathermap.org/api
WEATHER_API_KEY=tu_openweathermap_api_key

# Ejemplo de uso:
# 1. Copia este archivo como .env
# 2. Completa todos los valores con tu configuración real
# 3. Para OpenWeatherMap:
#    - Regístrate en https://openweathermap.org/api
#    - Confirma tu email
#    - Ve a API keys y copia tu clave
#    - Pégala en WEATHER_API_KEY
