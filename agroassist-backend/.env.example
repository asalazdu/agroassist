# =====================================
# CONFIGURACIÓN DE BASE DE DATOS MYSQL
# =====================================
DB_HOST=localhost
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=agroassist_db
DB_PORT=3306

# =====================================
# CONFIGURACIÓN DE AUTENTICACIÓN JWT
# =====================================
JWT_SECRET=tu_clave_secreta_muy_segura_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# =====================================
# CONFIGURACIÓN DEL SERVIDOR
# =====================================
PORT=3000
NODE_ENV=development

# =====================================
# API KEYS EXTERNAS
# =====================================

# OpenWeatherMap API (REQUERIDA para funcionalidad de clima)
# Obtén tu clave gratuita en: https://openweathermap.org/api
# Registrate, verifica tu email y copia tu API key aquí
WEATHER_API_KEY=tu_openweathermap_api_key_aqui

# OpenAI API (OPCIONAL - para funcionalidad avanzada de IA en chatbot)
# Obtén tu clave en: https://platform.openai.com/
# El chatbot funcionará sin esto, pero con funcionalidad limitada
OPENAI_API_KEY=tu_openai_api_key_aqui

# =====================================
# CONFIGURACIÓN DE EMAIL (OPCIONAL)
# =====================================
# Para funcionalidad de recuperación de contraseñas
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_app_password
EMAIL_FROM=tu_email@gmail.com

# =====================================
# INSTRUCCIONES DE CONFIGURACIÓN
# =====================================
# 1. Copia este archivo como .env (sin .example)
# 2. Reemplaza todos los valores que empiecen con "tu_" por tus datos reales
# 3. NUNCA subas el archivo .env a repositorios públicos
# 4. Para OpenWeatherMap: es GRATIS hasta 1000 llamadas/día
# 5. Para OpenAI: tiene costo pero el chatbot funciona sin él
# 6. Para MySQL: crea la base de datos usando el script en guia del proyecto/Script/
#    - Pégala en WEATHER_API_KEY
